# =============================================================================
# Studio — environment configuration
# Copy to `.env` (git-ignored) and adjust. Every key below is OPTIONAL:
# the app works 100% offline/local with all API keys left EMPTY.
# NEVER commit a real `.env`.
# =============================================================================

# ---------- Local services ----------
# Web dashboard (Next.js) port. The dashboard is opened at http://localhost:3000
WEB_PORT=3000
# REST API (Fastify) port
API_PORT=3001
# Python workers (FastAPI: whisper / tts / rvc) port
WORKERS_PORT=8001
# Base URL the web dashboard uses to reach the API (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Base URL the API uses to reach the Python workers
WORKERS_URL=http://localhost:8001

# ---------- Storage & binaries ----------
# Root folder for media/proxies/renders/exports/library + SQLite DB (relative to repo root)
STORAGE_DIR=./storage
# Root folder for downloaded models (whisper / piper / rvc)
MODELS_DIR=./models
# Absolute path to ffmpeg(.exe). Empty = use the one on PATH.
FFMPEG_PATH=
# Absolute path to ffprobe(.exe). Empty = use the one on PATH.
FFPROBE_PATH=
# Use NVIDIA CUDA in Python workers (faster-whisper / RVC). CPU by default.
USE_CUDA=false
# faster-whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo
# (recommended: small on CPU, large-v3-turbo on CUDA)
WHISPER_MODEL=small
# Default Piper voice id (Spanish; rioplatense). Alternative: es_MX-claude-high
PIPER_DEFAULT_VOICE=es_AR-daniela-high
# Log level for api/workers: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------- Optional cloud providers (leave EMPTY to disable) ----------
# ElevenLabs TTS (optional cloud voices)
ELEVENLABS_API_KEY=
# OpenAI (optional TTS / assistant)
OPENAI_API_KEY=
# Anthropic Claude (optional script/prompt assistant)
ANTHROPIC_API_KEY=
# Freesound.org (optional SFX search connector)
FREESOUND_API_KEY=
# Pixabay (optional stock images/video connector; Pixabay has no public audio API)
PIXABAY_API_KEY=
