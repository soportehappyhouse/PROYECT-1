# =============================================================================
# Studio — environment configuration
# Copy to `.env` (git-ignored) and adjust. Every key below is OPTIONAL:
# the app works 100% offline/local with all API keys left EMPTY.
# NEVER commit a real `.env`.
# =============================================================================

# ---------- Local services ----------
# Web dashboard (Next.js) port. The dashboard is opened at http://localhost:3000
WEB_PORT=3000
# REST API (Fastify) port
API_PORT=3001
# Python workers (FastAPI: whisper / tts / rvc) port
WORKERS_PORT=8001
# Base URL the web dashboard uses to reach the API (exposed to the browser; inlined at web build
# time from this file - start.ps1 rebuilds the web when .env changes). Empty = http://127.0.0.1:API_PORT
# Use 127.0.0.1, not localhost: the services listen on 127.0.0.1 only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Base URL the API uses to reach the Python workers
WORKERS_URL=http://127.0.0.1:8001

# ---------- Storage & binaries ----------
# Root folder for media/proxies/renders/exports/library + SQLite DB (relative to repo root)
STORAGE_DIR=./storage
# Root folder for downloaded models (whisper / piper / rvc)
MODELS_DIR=./models
# Absolute path to ffmpeg(.exe). Empty = use the one on PATH.
FFMPEG_PATH=
# Absolute path to ffprobe(.exe). Empty = use the one on PATH.
FFPROBE_PATH=
# Use NVIDIA CUDA in Python workers (faster-whisper / RVC). CPU by default.
USE_CUDA=false
# faster-whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo
# (recommended: small on CPU, large-v3-turbo on CUDA)
WHISPER_MODEL=small
# faster-whisper compute type (workers): auto = int8 on CPU, float16 on CUDA.
# Other values: int8 | int8_float16 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
# Default Piper voice id (Spanish; rioplatense). Alternative: es_MX-claude-high
PIPER_DEFAULT_VOICE=es_AR-daniela-high
# Log level for api/workers: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------- Local edit assistant (Sprint 3: Ollama, 100% local, no API key) ----------
# Ollama service the Python workers call (setup.ps1 installs it with winget; doctor.ps1 checks it).
# Must be loopback (127.0.0.1 / localhost / ::1): the prompt carries the project summary, so any
# other host is refused unless AGENT_ALLOW_REMOTE_OLLAMA=true (only if you really run Ollama on
# another machine you trust).
OLLAMA_URL=http://127.0.0.1:11434
AGENT_ALLOW_REMOTE_OLLAMA=false
# Model of the assistant (pack "agent-llm", downloaded through Ollama):
# qwen3:8b (default, ~5 GB) | hermes3:8b (alternative) | qwen3:0.6b (small, CI/tests)
# The api sends it to the workers as the default; Ajustes -> "Asistente local" can override it.
AGENT_MODEL=qwen3:8b
# Sampling temperature of the planner (0-2; low = more predictable plans). Default 0.2
AGENT_TEMPERATURE=0.2
# How long Ollama keeps the model in VRAM after a plan / eval / bug report (Ollama duration:
# 60s, 5m, 0). Short so Whisper/vision get the 6 GB card back soon; loading Whisper/vision also
# unloads it right away when VRAM is short. Default 60s
AGENT_KEEP_ALIVE=60s
# Context window of the planner (tokens). 4096 keeps qwen3:8b Q4 + KV cache inside 6 GB of VRAM.
AGENT_NUM_CTX=4096

# ---------- Export & job queue (api) ----------
# H.264 hardware encoder: auto = detect NVENC / QuickSync / AMF (falls back to libx264),
# off = always libx264 (CPU).
HW_ENCODER=auto
# Block render cache (storage/cache/segments): max size in GB, least recently used blocks are
# deleted first. 0 = do not keep blocks between exports.
SEGMENT_CACHE_MAX_GB=10
# Max concurrent jobs per queue lane (FFmpeg: 1-8, motion renders: 1-4, Python workers: 1-4)
QUEUE_FFMPEG_CONCURRENCY=2
QUEUE_MOTION_CONCURRENCY=1
QUEUE_WORKERS_CONCURRENCY=1

# ---------- Motion graphics: Remotion renderer (api) ----------
# Browser tabs per render: a number or a percentage of CPU threads. Empty = 50%
REMOTION_CONCURRENCY=
# Chrome Headless Shell executable. Empty = auto-detect the one downloaded by
# `pnpm --filter @studio/remotion browser:ensure` (setup.ps1 runs it).
REMOTION_BROWSER_EXECUTABLE=
# true = try GPU encoding (if-possible); false = CPU only
REMOTION_HW_ACCEL=false
# system = never download fonts (default; first render works offline)
# google = load Google Fonts (opt-in; needs internet the first time)
REMOTION_FONTS=system
# Bundle cache folder. Empty = storage/tmp/remotion-bundle
REMOTION_BUNDLE_CACHE=
# Timeout (ms) for fonts/media to load in each frame. Empty = 60000
REMOTION_TIMEOUT_MS=

# ---------- Optional cloud providers (leave EMPTY to disable) ----------
# ElevenLabs TTS (optional cloud voices)
ELEVENLABS_API_KEY=
# ElevenLabs model used by the workers (not a secret)
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI (optional TTS / assistant)
OPENAI_API_KEY=
# OpenAI TTS model used by the workers (not a secret)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Anthropic Claude (optional script/prompt assistant)
ANTHROPIC_API_KEY=
# Freesound.org (optional SFX search connector)
FREESOUND_API_KEY=
# Pixabay (optional stock images/video connector; Pixabay has no public audio API)
PIXABAY_API_KEY=
