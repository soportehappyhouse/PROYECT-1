{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./storage/*.db*)",
      "Read(./storage/reports/**)",
      "Read(./storage/consent/**)",
      "Edit(./storage/**)",
      "Write(./storage/**)",
      "Read(./models/**)",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(Invoke-RestMethod:*)",
      "Bash(iwr:*)",
      "Bash(irm:*)",
      "Bash(sqlite3:*)"
    ]
  }
}
