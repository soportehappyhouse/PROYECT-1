{
  "name": "@studio/api",
  "version": "0.1.0",
  "private": true,
  "description": "Local REST API (Fastify 5): projects, media, SQLite job queue, FFmpeg/Remotion/workers orchestration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=@studio/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@studio/motion-engines": "workspace:*",
    "@studio/remotion": "workspace:*",
    "@studio/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "nanoid": "^5.1.16",
    "p-queue": "^9.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
