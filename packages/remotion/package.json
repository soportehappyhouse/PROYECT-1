{
  "name": "@studio/remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion 4 compositions (titles, lower-thirds, animated subtitles, transitions) + programmatic render",
  "type": "module",
  "exports": {
    ".": {
      "@studio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "studio": "remotion studio src/entry.ts",
    "render:example": "remotion render src/entry.ts title-card out/title-card.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@studio/motion-engines": "workspace:*",
    "@studio/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.532",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
