{
  "name": "@studio/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared zod schemas, TypeScript types and constants (single source of truth for the API contract)",
  "type": "module",
  "exports": {
    ".": {
      "@studio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "export-schemas": "tsc -p tsconfig.build.json && node scripts/export-schemas.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
