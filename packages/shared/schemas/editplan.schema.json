  "required": ["version", "summary_es", "ops"],
  "additionalProperties": false,
  "description": "Plan de edición propuesto por el asistente local.",
  "$defs": {
    "ClipRef": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Id exacto del clip (solo si figura en el resumen).",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "Nombre (o parte del nombre) del clip o de su archivo, como lo dijo el usuario.",
          "type": "string",
          "minLength": 1
        },
        "index": {
          "description": "Posición del clip por orden de inicio: 1 = primero, 2 = segundo; -1 = último, -2 = anteúltimo. Si se da `track`, cuenta solo en ese tipo de pista.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "track": {
          "description": "Tipo de pista donde está el clip (filtra la búsqueda).",
          "type": "string",
          "enum": ["video", "audio", "text", "motion"]
        },
        "at": {
          "description": "Clip que está en pantalla en ese momento.",
          "$ref": "#/$defs/Time"
        }
      },
      "additionalProperties": false,
      "description": "Referencia a un clip: id, nombre, posición (index), tipo de pista y/o momento (at). La API la resuelve a un id; si es ambigua, devuelve una pregunta."
    },
    "Time": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Segundos desde el inicio de la línea de tiempo."
        },
        {
          "type": "string",
          "enum": ["start", "end", "cursor"],
          "description": "start = inicio del video, end = final del video, cursor = posición del cabezal."
        },
        {
          "type": "object",
          "properties": {
            "scene": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Número de escena detectada (1 = primera escena); se usa su inicio."
            }
          },
          "required": ["scene"],
          "additionalProperties": false,
          "description": "Inicio de una escena detectada."
        },
        {
          "type": "object",
          "properties": {
            "after_clip": {
              "description": "Clip de referencia; se usa el final de ese clip.",
              "$ref": "#/$defs/BaseClipRef"
            }
          },
          "required": ["after_clip"],
          "additionalProperties": false,
          "description": "Justo después de que termina un clip."
        }
      ],
      "description": "Momento en la línea de tiempo: segundos, 'start', 'end', 'cursor', {scene: n} o {after_clip: ClipRef}. Nunca inventar tiempos: si el usuario no lo dijo, preguntar."
    },
    "PointTime": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Segundos desde el inicio de la línea de tiempo."
        },
        {
          "type": "string",
          "enum": ["start", "end", "cursor"],
          "description": "start = inicio del video, end = final del video, cursor = posición del cabezal."
        },
        {
          "type": "object",
          "properties": {
            "scene": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Número de escena detectada (1 = primera escena); se usa su inicio."
            }
          },
          "required": ["scene"],
          "additionalProperties": false,
          "description": "Inicio de una escena detectada."
        }
      ]
    },
    "BaseClipRef": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Id exacto del clip (solo si figura en el resumen).",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "Nombre (o parte del nombre) del clip o de su archivo, como lo dijo el usuario.",
          "type": "string",
          "minLength": 1
        },
        "index": {
          "description": "Posición del clip por orden de inicio: 1 = primero, 2 = segundo; -1 = último, -2 = anteúltimo. Si se da `track`, cuenta solo en ese tipo de pista.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "track": {
          "description": "Tipo de pista donde está el clip (filtra la búsqueda).",
          "type": "string",
          "enum": ["video", "audio", "text", "motion"]
        },
        "at": {
          "description": "Clip que está en pantalla en ese momento.",
          "$ref": "#/$defs/PointTime"
        }
      },
      "additionalProperties": false,
      "description": "Referencia a un clip del proyecto."
    }
  },
  "$id": "https://studio.local/schemas/editplan.schema.json",
  "title": "EditPlan"
}
