{
  "name": "@studio/studio-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP (stdio) de Studio para Claude Code: herramientas que llaman a la API local",
  "type": "module",
  "bin": {
    "studio-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
